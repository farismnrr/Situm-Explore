EXPO_PUBLIC_ENVIRONMENT=dev
EXPO_PUBLIC_API_BASE_URL=https://replace-with-your-situm-explore-origin.example
# Optional public HTTPS host for Universal Links / Android App Links. Leave blank until association files are deployed.
EXPO_PUBLIC_UNIVERSAL_LINK_HOST=
EXPO_PUBLIC_APP_VERSION=0.1.1
EXPO_PUBLIC_ANDROID_VERSION_CODE=5
EXPO_PUBLIC_IOS_BUILD_NUMBER=1

# Optional lab/staging HTTPS update feed override. Production defaults to the Situm Explore OTA endpoint.
EXPO_PUBLIC_ANDROID_UPDATE_MANIFEST_URL=
