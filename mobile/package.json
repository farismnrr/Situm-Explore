{
  "name": "situm-explore-mobile",
  "version": "0.1.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "postinstall": "patch-package",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:android": "cd android && ./gradlew assembleDebug",
    "build:android:release": "node scripts/build-android-release.cjs",
    "build:android:device": "node scripts/build-android-device.cjs"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@situm/react-native"
        ]
      }
    }
  },
  "dependencies": {
    "@situm/react-native": "3.19.2",
    "expo": "~57.0.14",
    "expo-application": "~57.0.2",
    "expo-build-properties": "~57.0.12",
    "expo-file-system": "~57.0.4",
    "expo-gl": "~57.0.2",
    "expo-intent-launcher": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "three": "0.162.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/three": "0.162.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.8.1",
    "patch-package": "8.0.1",
    "typescript": "~6.0.3"
  }
}
